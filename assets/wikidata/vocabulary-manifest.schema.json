{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exif-turbo.example/schemas/wikidata-vocabulary-manifest-v1.json",
  "title": "EXIF Turbo Wikidata vocabulary manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_version",
    "created_at",
    "source",
    "concepts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dump_uri", "dump_sha256", "license_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dump_uri": {"type": "string", "minLength": 1},
        "dump_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_id": {"const": "CC0-1.0"}
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qid", "category"],
        "properties": {
          "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
          "category": {"enum": ["subject", "genre_format"]}
        }
      }
    }
  }
}